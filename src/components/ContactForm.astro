---
import { contact } from '../data/site';
---
<section class="contact-panel" id="contato">
  <div>
    <p class="kicker">Vamos avaliar o seu cenário</p>
    <h2>Seu ponto de recarga começa com uma boa leitura do imóvel.</h2>
    <p>Envie fotos do quadro, relógio e vaga. A triagem ajuda a definir o próximo passo com clareza.</p>
  </div>
  <form id="whatsapp-lead-form" data-phone={contact.phone}>
    <label>
      Nome
      <input name="nome" autocomplete="name" maxlength="80" placeholder="Como podemos te chamar?" required />
    </label>
    <label>
      Bairro ou cidade
      <input name="localizacao" autocomplete="address-level2" maxlength="80" placeholder="Ex.: Pinheiros, São Paulo" required />
    </label>
    <label>
      Tipo de imóvel
      <select name="tipo" required>
        <option>Casa ou sobrado</option>
        <option>Condomínio</option>
        <option>Empresa ou frota</option>
        <option>Quero uma consultoria</option>
      </select>
    </label>
    <label>
      Veículo ou carregador <small>Opcional</small>
      <input name="veiculo" maxlength="100" placeholder="Ex.: BYD Dolphin ou Wallbox já comprado" />
    </label>
    <button class="button primary" type="submit">Continuar no WhatsApp <span aria-hidden="true">↗</span></button>
    <p class="form-note">Ao continuar, a conversa abre no WhatsApp. Se puder, envie fotos do quadro e da vaga.</p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#whatsapp-lead-form');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const name = String(data.get('nome') ?? '').trim();
    const location = String(data.get('localizacao') ?? '').trim();
    const propertyType = String(data.get('tipo') ?? '').trim();
    const vehicle = String(data.get('veiculo') ?? '').trim();
    const trackingLayer = (window as typeof window & { dataLayer?: Array<Record<string, unknown>> }).dataLayer;
    trackingLayer?.push({ event: 'generate_lead', lead_method: 'whatsapp_form', property_type: propertyType });
    const message = [
      'Olá, gostaria de avaliar a instalação de um carregador.',
      '',
      `Nome: ${name}`,
      `Bairro ou cidade: ${location}`,
      `Tipo de imóvel: ${propertyType}`,
      vehicle ? `Veículo ou carregador: ${vehicle}` : '',
      '',
      'Posso enviar fotos do quadro e da vaga.',
    ].filter(Boolean).join('\n');
    const destination = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(message)}`;

    window.open(destination, '_blank', 'noopener,noreferrer');
  });
</script>
