---
import Header from './Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { route, whatsapp } from '../data/site';
const { guide } = Astro.props;
const linkText = (value: string) => value.replace(/\[([^\]]+)\]\((\/[^)]+)\)/g, (_match, label, href) => `<a href="${route(href)}">${label}</a>`);
---
<BaseLayout title={`${guide.title} | Volt City`} description={guide.description} canonicalPath={`/guias/${guide.slug}/`}>
  <Header />
  <main class="editorial-page">
    <nav class="breadcrumbs" aria-label="Trilha de navegação"><a href={route('/')}>Início</a><span>›</span><a href={route('/guias/')}>Guias</a><span>›</span><span>{guide.category}</span></nav>
    <header class="article-header"><p class="kicker">Guia Volt City · {guide.category}</p><h1>{guide.title}</h1><p class="content-intro">{guide.intro}</p></header>
    <div class="article-layout">
      <article class="article-body">
        {guide.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p set:html={linkText(paragraph)} />)}</section>)}
        <section class="article-faq"><h2>Perguntas frequentes</h2>{guide.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</section>
      </article>
      <aside class="article-aside"><p class="kicker">Continue a leitura</p><ul>{guide.related.map((item) => <li><a href={route(item.href)}>{item.label} <span>↗</span></a></li>)}</ul><a class="button primary" href={whatsapp(`Olá, Marcos. Li o guia “${guide.title}” e quero avaliar meu cenário.`)} target="_blank" rel="noreferrer">Avaliar meu cenário</a></aside>
    </div>
  </main>
</BaseLayout>
