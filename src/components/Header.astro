---
import { asset, whatsapp } from '../data/site';
const quote = whatsapp('Olá, Marcos. Gostaria de solicitar um orçamento para instalação de Wallbox.');
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`;
---
<header class="site-header"><a href={base} class="brand" aria-label="Volt City, início"><img class="brand-logo" src={asset('/images/volt-city-logo-transparent.png')} alt="Volt City soluções inteligentes" /></a><nav aria-label="Navegação principal"><a href={`${base}#solucoes`}>Soluções</a><a href={`${base}#processo`}>Como funciona</a><a href={`${base}#projetos`}>Instalações</a><a href={`${base}#faq`}>Dúvidas</a></nav><a class="header-cta" href={quote} target="_blank" rel="noreferrer">Solicitar orçamento <span>↗</span></a></header>
