---
import { asset, contact, whatsapp } from '../data/site';
const quote = whatsapp('Olá, gostaria de avaliar a instalação de um carregador. Meu imóvel é [casa, condomínio ou empresa], fica em [bairro/cidade] e meu veículo é [modelo]. Posso enviar fotos do quadro e da vaga.');
---
<section id="inicio" class="hero"><div class="hero-copy"><p class="signal"><i></i> São Paulo, interior e litoral · base no Butantã/Rio Pequeno</p><h1>Instalação de Wallbox em <em>São Paulo.</em></h1><p class="hero-lead">Projetos de recarga para casas, condomínios e empresas, do quadro elétrico à vaga — com execução cuidadosa e acompanhamento após a instalação.</p><div class="actions"><a class="button primary" href={quote} target="_blank" rel="noreferrer" data-track="contact" data-track-location="hero">Avaliar meu projeto <span>↗</span></a><a class="button ghost" href="#projetos" data-track="select_content" data-track-location="hero" data-track-content-type="navigation" data-track-content-name="projetos">Ver instalações</a></div><dl class="proof"><div><dt>Atendimento direto</dt><dd>uma conversa clara desde o início</dd></div><div><dt>Projeto sob medida</dt><dd>cada imóvel pede um caminho</dd></div><div><dt>Após a entrega</dt><dd>seguimos acompanhando o ponto</dd></div></dl></div><div class="hero-visual"><img src={asset('/images/residencial-installation.png')} alt="Instalação de Wallbox GWM em veículo elétrico, com técnico da Volt City" /><div class="visual-tag top">CAMPO / SP</div><div class="visual-tag bottom">RESIDENCIAL · CONDOMÍNIO · EMPRESA</div><div class="visual-card"><span>Contato direto</span><strong>Marcos Cardoso</strong><a href={quote} target="_blank" rel="noreferrer" data-track="contact" data-track-location="hero_phone">{contact.displayPhone}</a></div></div></section>
